{
  "name": "streaming-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "share": "node scripts/share.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "verify:browser": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.3.4",
    "peerjs": "1.5.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.4",
    "peer": "^1.0.2",
    "postcss": "8.5.28",
    "prettier": "3.3.2",
    "tailwindcss": "3.4.4",
    "tsx": "4.23.13",
    "typescript": "5.5.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "qs": "6.16.0"
  }
}
