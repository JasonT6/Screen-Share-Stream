# Optional PUBLIC build-time signaling settings. No secrets belong here.
# Native WSS to PeerServer; no PeerJS client or RTC data channel.
# Defaults below require no backend operated by you. Plain WS is loopback-only.
NEXT_PUBLIC_PEER_HOST=0.peerjs.com
NEXT_PUBLIC_PEER_PORT=443
NEXT_PUBLIC_PEER_PATH=/
NEXT_PUBLIC_PEER_SECURE=true
# STUN-only discovery is configured in lib/media.ts. No TURN/media relay.
